# 식스샵 관리자 로그인
SIXSHOP_EMAIL=you@example.com
SIXSHOP_PASSWORD=changeme
SIXSHOP_STORE_ID=your-store-id   # 관리자 URL에서 확인 (예: admin.sixshop.com/{store-id}/...)

# Google Sheets
# 로컬 개발: 다운로드한 서비스계정 JSON 파일 경로만 적으면 됨 (추천)
GOOGLE_SERVICE_ACCOUNT_PATH=~/Downloads/sixshop-collector-xxxxx.json
# GitHub Actions: PATH 대신 JSON 한 줄 문자열로 (Actions secret으로 등록)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

SHEET_ID=1AbCdEfGhIjK...                 # 구글 시트 URL의 /d/ 다음 ID
ORDERS_SHEET_NAME=주문로그
STATE_SHEET_NAME=_state

# 옵션
COLLECT_DAYS=3                            # 최근 며칠치 주문을 점검할지 (cron 1시간이면 1~3일이면 충분)
HEADLESS=true
DEBUG_DUMP_XHR=false                      # true면 첫 실행 시 식스샵 XHR 응답을 JSON으로 덤프 (스키마 파악용)

# 에이블리 일일 보고서 (src/ably-daily.ts — 맥미니 launchd)
ABLY_EMAIL=...
ABLY_PASSWORD=...
ABLY_AD_MARKET_SNO=...
ABLY_MARKET_NAME=...
# 비공개 레포 j65209/brightbeed-reports 에 contents 쓰기 권한이 있는 토큰
REPORTS_GITHUB_TOKEN=...

# 공홈 실시간 보고서 (src/home-live.ts — 맥미니 mac/jobs/home-live.job 30분마다, docs/HOME-DAILY.md)
# 식스샵 프로 관리자 로그인 — 코페리 · 아페티 · 코즈미 상점이 다 보이는 계정 하나
SIXSHOP_PRO_EMAIL=you@example.com
SIXSHOP_PRO_PASSWORD=changeme
# 소유자 로그인이면 owner(기본), 관리자(직원) 로그인이면 user
SIXSHOP_PRO_LOGIN_TYPE=owner
# 결제수수료 가정 — 실제 요율을 알면 바꿀 것 (식스샵 자체 결제 / 네이버페이 주문형)
HOME_FEE_RATE=0.035
HOME_NAVERPAY_FEE_RATE=0.035
# 1688 위안 단가 → 원 (클리어타입 · 프로덕트피알 원가) — 아페티 · 코즈미 MD팀 시트와 같은 300
HOME_CNY_KRW=300
