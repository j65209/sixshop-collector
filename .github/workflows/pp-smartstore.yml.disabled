name: pp-smartstore-sync

# PP 스마트스토어 동기화 + PP 재고마스터 작성.
# 네이버 SmartStore API가 사장님 PC IP 화이트리스트라 self-hosted runner에서만 가능.
# collect.yml에서 분리된 이유: self-hosted runner가 offline이면 pp 단계가
# 큐에 쌓여 collect.yml의 concurrency group을 막아 버튼 트리거가 작동 안 함.
# 분리해서 collect는 항상 즉시 돌고, pp는 self-hosted가 살아있을 때만 진행되게 함.
on:
  workflow_run:
    workflows: ["collect-sixshop-orders"]
    types: [completed]
    branches: [main]
  workflow_dispatch:

concurrency:
  group: pp-smartstore
  cancel-in-progress: false

jobs:
  pp-smartstore:
    # collect 성공 후에만 (workflow_run의 conclusion 체크) — 수동 dispatch는 항상 진행
    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}
    runs-on: [self-hosted, windows, brightbeed]
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - name: Install deps (skip Playwright browsers)
        env:
          PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: "1"
        run: npm install --ignore-scripts
        shell: cmd

      - name: Run PP SmartStore sync + refresh master
        env:
          SIXSHOP_EMAIL_PP: ${{ secrets.SIXSHOP_EMAIL_PP }}
          SIXSHOP_PASSWORD_PP: ${{ secrets.SIXSHOP_PASSWORD_PP }}
          NAVER_CLIENT_ID_PP: ${{ secrets.NAVER_CLIENT_ID_PP }}
          NAVER_CLIENT_SECRET_PP: ${{ secrets.NAVER_CLIENT_SECRET_PP }}
          GOOGLE_SERVICE_ACCOUNT_JSON: ${{ secrets.GOOGLE_SERVICE_ACCOUNT_JSON }}
          SHEET_ID: ${{ secrets.SHEET_ID }}
          STATE_SHEET_NAME: ${{ vars.STATE_SHEET_NAME || '_state' }}
          SS_DEBUG: "1"
        run: npm run vm-pp-cycle
        shell: cmd
